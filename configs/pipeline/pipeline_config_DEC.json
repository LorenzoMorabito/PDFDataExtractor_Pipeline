      "sottocapitoli": {
        "OVERVIEW": [
          62,
          65
        ]
      }
    }
  },
  "year_ref": 2025,
  "output": {
    "qc_summary_path": "artifacts/qc/dec_2025_qc.csv",
    "errors_path": "artifacts/qc/dec_2025_errors.json",
    "df_to_analyze_path": "artifacts/qc/dec_2025_df_to_analyze",
    "log_percentage_path": "artifacts/qc/dec_2025_log_percentage.csv",
    "run_report_path": "artifacts/monitoring/dec_2025_run_report.json",
    "table_name": "dev_marketing_catalog.finance_pdf.t_finance_data_pdf",
    "write_mode": "merge",
    "key_columns": [
      "record_hash"
    ],
    "partition_by": [
